# Salin menjadi .env lalu sesuaikan. JANGAN di-commit / dipublikasikan.
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
# Path URL aplikasi di web server (tanpa slash akhir). Root domain: kosongkan.
BASE_URL=/secure-admin-system

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=secure_admin_system
DB_USER=root
DB_PASS=

# Versi master key AES aktif -> file storage/keys/master_v{N}.key
KEY_VERSION=1
# (Opsional, disarankan di produksi) folder master key di LUAR document root
KEY_DIR=

# Token pendaftaran admin pertama (min 16 karakter, acak). Dipakai tools/setup_admin.php
SETUP_TOKEN=GANTI_DENGAN_TOKEN_ACAK_PANJANG

# (Opsional) IP reverse proxy tepercaya agar X-Forwarded-For dipakai
TRUSTED_PROXY=
